# Google Gemini API Key (Free tier available)
# Get your free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Server port (defaults to 3000 and auto-fallbacks if busy)
PORT=3000

# Optional: Enable AI features (set to 'true' after adding GEMINI_API_KEY)
AI_ENABLED=false

# Optional: Choose Gemini model (default: gemini-1.5-flash for free tier)
# Other options (may require billing): gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
